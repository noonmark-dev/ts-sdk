{
  "name": "@noonmark/sdk",
  "version": "0.2.0",
  "description": "Read a Noonmark Form definition and send Submissions",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "smoke": "node scripts/smoke.mjs",
    "release": "bash scripts/release.sh",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "noonmark",
    "forms",
    "feedback",
    "survey",
    "submissions",
    "sdk"
  ],
  "homepage": "https://github.com/noonmark-dev/ts-sdk#readme",
  "bugs": {
    "url": "https://github.com/noonmark-dev/ts-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noonmark-dev/ts-sdk.git"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.18.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
